# The ticket builder (tickets.py) needs no keys and no network beyond the one-time dataset download.
# The two-arm check (check.py) needs a Mubit instance and the Cloudflare Workers AI pair for Jev.
MUBIT_ENDPOINT=https://api.mubit.ai
MUBIT_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Until the mubit-sdk release that carries decide() ships, make needs MUBIT_SDK, a checkout of
# sdk/python/mubit-sdk (branch feat/jev-external), in the environment or the repository-root .env:
# make reads only that file. It installs the checkout over the pinned SDK for the check and its tests.
